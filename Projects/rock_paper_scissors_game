import random


playerWin = 0
opponentWin = 0
draw = 0
options = ["rock", "paper", "scissors"]

while True:
    playerPick = input("Write 'rock', 'paper' or 'scissors'. Press E to Exit: ").lower()
    if playerPick == "e":
        break

    if playerPick not in options:
        continue

    randomNumb = random.randint(0,2) # rock [0] paper [1] scissors [2]

    opponentPick = options[randomNumb]
    print("Opponent has picked " + opponentPick + ".")

    if playerPick == "rock" and opponentPick == "scissors":
        playerWin += 1
        print("You won!")
        print("rock beats scissors!")
    elif playerPick == "paper" and opponentPick == "rock":
            playerWin += 1
            print("You won!")
            print("paper beats rock!")
    elif playerPick == "scissors" and opponentPick == "paper":
                playerWin += 1
                print("You won!")
                print("scissors beats paper!")
    elif playerPick == opponentPick:
          print("Draw!")
          draw += 1
    else:
          print("You lost!")
          opponentWin += 1

print(f"You won {playerWin} time(s) and opponent won {opponentWin} time(s) and you picked the same {draw} time(s)")
print("Farewell!")


